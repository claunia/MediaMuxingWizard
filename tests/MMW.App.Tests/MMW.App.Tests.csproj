<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia.Headless.XUnit 12.1 is built against xUnit v3 3.2. -->
    <PackageReference Include="xunit.v3.mtp-v2" VersionOverride="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The string tables, read by the localization tests. -->
    <None Include="..\..\src\MMW.App\Resources\Strings*.resx" LinkBase="Resources" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MMW.App\MMW.App.csproj" />
    <ProjectReference Include="..\..\src\MMW.Metadata\MMW.Metadata.csproj" />
    <ProjectReference Include="..\..\src\MMW.Media.Conversion\MMW.Media.Conversion.csproj" />
    <ProjectReference Include="..\MMW.TestSupport\MMW.TestSupport.csproj" />
  </ItemGroup>
</Project>
