<Project>
  <!-- Compiles the provider API keys into the assembly so every build works without an appsettings.json next to it.
       Sources (later wins): the git-ignored appsettings.json at the repository root, then the MSBuild properties or
       environment variables MMW_TMDB_API_KEY, MMW_TVDB_API_KEY and MMW_FANARTTV_API_KEY (for CI secrets).
       The keys are XOR'd with a deterministic pad so they do not show up as plain strings in the binary; this is
       obfuscation only. Missing sources give empty keys, so a fresh clone still builds. -->
  <PropertyGroup>
    <BundledApiKeysSettingsFile>$(MSBuildThisFileDirectory)..\..\appsettings.json</BundledApiKeysSettingsFile>
  </PropertyGroup>

  <UsingTask TaskName="GenerateBundledApiKeys" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SettingsFile ParameterType="System.String" Required="true" />
      <TheMovieDb ParameterType="System.String" />
      <TheTvDb ParameterType="System.String" />
      <FanartTv ParameterType="System.String" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var names = new[] { "TheMovieDb", "TheTvDb", "FanartTv" };
        var keys = new string[names.Length];
        if (File.Exists(SettingsFile))
        {
            // A small regex parse keeps the task free of assembly references that differ between MSBuild hosts.
            var section = Regex.Match(File.ReadAllText(SettingsFile), "\"ApiKeys\"\\s*:\\s*\\{([^}]*)\\}", RegexOptions.IgnoreCase);
            for (var i = 0; section.Success && i < names.Length; i++)
            {
                var value = Regex.Match(section.Groups[1].Value, "\"" + names[i] + "\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"", RegexOptions.IgnoreCase);
                if (value.Success)
                    keys[i] = Regex.Replace(value.Groups[1].Value, "\\\\(.)", "$1");
            }
        }

        var overrides = new[] { TheMovieDb, TheTvDb, FanartTv };
        for (var i = 0; i < names.Length; i++)
        {
            if (!string.IsNullOrWhiteSpace(overrides[i]))
                keys[i] = overrides[i];
        }

        var code = new StringBuilder();
        code.AppendLine("// <auto-generated>Generated by BundledApiKeys.targets from the git-ignored API keys. Do not commit.</auto-generated>");
        code.AppendLine("namespace MMW.Metadata;");
        code.AppendLine();
        code.AppendLine("internal static partial class BundledApiKeys");
        code.AppendLine("{");
        for (var i = 0; i < names.Length; i++)
        {
            var plain = Encoding.UTF8.GetBytes((keys[i] ?? string.Empty).Trim());
            var pad = new byte[plain.Length];
            using (var sha = SHA256.Create())
            {
                for (var block = 0; block * 32 < pad.Length; block++)
                {
                    var hash = sha.ComputeHash(Encoding.UTF8.GetBytes("MMW.BundledApiKeys/" + names[i] + "/" + block));
                    Array.Copy(hash, 0, pad, block * 32, Math.Min(32, pad.Length - block * 32));
                }
            }

            var cipher = plain.Select((b, j) => (byte)(b ^ pad[j]));
            code.AppendLine("    internal static readonly byte[] " + names[i] + "Pad = [" + string.Join(", ", pad) + "];");
            code.AppendLine("    internal static readonly byte[] " + names[i] + "Data = [" + string.Join(", ", cipher) + "];");
        }

        code.AppendLine("}");

        var text = code.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBundledApiKeys" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- IntermediateOutputPath is only known once the SDK targets are evaluated, hence set here. -->
      <BundledApiKeysOutputFile>$(IntermediateOutputPath)BundledApiKeys.g.cs</BundledApiKeysOutputFile>
    </PropertyGroup>
    <GenerateBundledApiKeys SettingsFile="$(BundledApiKeysSettingsFile)"
                            TheMovieDb="$(MMW_TMDB_API_KEY)"
                            TheTvDb="$(MMW_TVDB_API_KEY)"
                            FanartTv="$(MMW_FANARTTV_API_KEY)"
                            OutputFile="$(BundledApiKeysOutputFile)" />
    <ItemGroup>
      <Compile Include="$(BundledApiKeysOutputFile)" />
      <FileWrites Include="$(BundledApiKeysOutputFile)" />
    </ItemGroup>
  </Target>
</Project>
