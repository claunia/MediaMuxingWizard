<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMW.App.ViewModels"
             xmlns:md="using:MMW.Core.Metadata"
             x:Class="MMW.App.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">
  <DockPanel Width="680" Height="540">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" />
      <Button Content="OK" Command="{Binding AcceptCommand}" IsDefault="True" Classes="accent" MinWidth="80" />
    </StackPanel>
    <TabControl>
      <TabItem Header="General">
        <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Margin="0,12">
          <TextBlock Text="Appearance:" Classes="label" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:PreferencesViewModel.Themes}" SelectedItem="{Binding Theme}" MinWidth="220" />
          <TextBlock Grid.Row="1" Text="Window:" Classes="label" />
          <CheckBox Grid.Row="1" Grid.Column="1" Content="Remember size" IsChecked="{Binding RememberWindowSize}" />
          <TextBlock Grid.Row="2" Text="Show ratings for:" Classes="label" />
          <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
            <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.RatingCountries}" SelectedItem="{Binding RatingsCountry}" MinWidth="220" />
            <TextBlock Text="USA ratings are always shown." Classes="dim" FontSize="12" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Saving">
        <StackPanel Spacing="8" Margin="0,12">
          <CheckBox Content="Optimize when saving (interleave, header first)" IsChecked="{Binding OptimizeOnSave}" />
          <CheckBox Content="Always use 64-bit chunk offsets (automatic above 4 GB)" IsChecked="{Binding Use64BitOffsets}" />
          <CheckBox Content="Use 64-bit times" IsChecked="{Binding Use64BitTimes}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Audio">
        <StackPanel Spacing="10" Margin="0,12">
          <TextBlock Text="{x:Static vm:PreferencesViewModel.FFmpegStatus}" Classes="dim" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Text="Downmix audio to:" Classes="label" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:PreferencesViewModel.Mixdowns}" SelectedItem="{Binding Mixdown}" MinWidth="240" />
            <TextBlock Grid.Row="1" Text="AAC bitrate per channel:" Classes="label" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding BitratePerChannel}" Minimum="64" Maximum="320" Increment="16" FormatString="0" Width="140" />
              <TextBlock Text="kbit/s" VerticalAlignment="Center" Classes="dim" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Dynamic range compression:" Classes="label" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Slider Minimum="0" Maximum="4" Value="{Binding Drc}" Width="200" TickFrequency="0.5" IsSnapToTickEnabled="True" />
              <TextBlock Text="{Binding Drc, StringFormat='{}{0:0.0}'}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <CheckBox Content="Suggest converting AC-3 audio to AAC when importing into MP4" IsChecked="{Binding ConvertAc3}" />
          <CheckBox Content="Suggest AAC + Passthru for DTS audio when importing into MP4" IsChecked="{Binding ConvertDts}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Metadata" IsVisible="{Binding HasMetadata}">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="0,12,8,0">
            <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Movies:" Classes="label" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding MovieProviders}" SelectedItem="{Binding DefaultMovieProvider}" MinWidth="200" />
              <TextBlock Grid.Row="1" Text="TV shows:" Classes="label" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TvProviders}" SelectedItem="{Binding DefaultTvProvider}" MinWidth="200" />
              <TextBlock Grid.Row="2" Text="TheMovieDB key:" Classes="label" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TmdbApiKey}" PasswordChar="•" PlaceholderText="From appsettings.json or the environment" />
              <TextBlock Grid.Row="3" Text="TheTVDB key:" Classes="label" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TvdbApiKey}" PasswordChar="•" PlaceholderText="From appsettings.json or the environment" />
            </Grid>
            <CheckBox Content="Overwrite existing tags" IsChecked="{Binding MetadataOverwrite}" />
            <CheckBox Content="Keep existing values the result does not provide" IsChecked="{Binding MetadataKeepEmpty}" />
            <CheckBox Content="Replace existing artwork with the chosen artwork" IsChecked="{Binding ReplaceArtworkOnSearch}" />
            <CheckBox Content="Detect 4K for HD Video (some Apple TV models then refuse 1080p streaming)" IsChecked="{Binding Autodetect4K}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Delete Cached Results" Command="{Binding ClearCacheCommand}" />
              <TextBlock Text="{Binding CacheStatus}" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Map provider values to tags" Classes="groupHeader" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <RadioButton Content="Movies" IsChecked="{Binding !EditTvMap}" GroupName="map" />
              <RadioButton Content="TV shows" IsChecked="{Binding EditTvMap}" GroupName="map" />
            </StackPanel>
            <ListBox ItemsSource="{Binding MapEntries}" SelectedItem="{Binding SelectedMapEntry}" Height="180">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MapEntryViewModel">
                  <Grid ColumnDefinitions="190,*">
                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.MapTags}" SelectedItem="{Binding Tag}" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="md:TagDefinition"><TextBlock Text="{Binding Name}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{Binding Template}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="icon" Command="{Binding AddMapEntryCommand}" AutomationProperties.Name="Add a mapping" ToolTip.Tip="Add a mapping"><PathIcon Data="{StaticResource IconAdd}" /></Button>
              <Button Classes="icon" Command="{Binding RemoveMapEntryCommand}" AutomationProperties.Name="Remove the mapping" ToolTip.Tip="Remove the mapping"><PathIcon Data="{StaticResource IconDelete}" /></Button>
              <Button Content="Restore Defaults" Command="{Binding RestoreMapCommand}" />
              <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.MapTokens}" PlaceholderText="Available values" MinWidth="200" Margin="12,0,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Sets">
        <DockPanel Margin="0,12">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
            <Button Classes="icon" Command="{Binding RemovePresetCommand}" AutomationProperties.Name="Remove the selected set" ToolTip.Tip="Remove the selected set"><PathIcon Data="{StaticResource IconDelete}" /></Button>
            <Button Classes="icon" Command="{Binding MovePresetUpCommand}" AutomationProperties.Name="Move up (sets 1–9 have keyboard shortcuts)" ToolTip.Tip="Move up (sets 1–9 have keyboard shortcuts)"><PathIcon Data="{StaticResource IconUp}" /></Button>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Saved sets are applied from the Sets button in the metadata inspector." Classes="dim" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="md:MetadataPreset">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="dim" FontSize="11" Text="{Binding Values.Count, StringFormat='{}{0} tags'}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="File Name">
        <StackPanel Spacing="10" Margin="0,12">
          <CheckBox Content="Name saved files from their tags" IsChecked="{Binding UseFileNameFormat}" />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding UseFileNameFormat}">
            <TextBlock Text="Movies:" Classes="label" />
            <TextBox Grid.Column="1" Text="{Binding MovieFormat}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MoviePreview}" Classes="dim" FontSize="12" />
            <TextBlock Grid.Row="2" Text="TV shows:" Classes="label" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TvFormat}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TvPreview}" Classes="dim" FontSize="12" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Classes="dim" FontSize="12"
                     Text="Use {Tag Name} tokens. Add :00 for leading zeros, :yyyy for a date's year, and |upper, |lower, |capitalize, |camel, |snake, |train or |dot to change case." />
          <Button Content="Restore Defaults" Command="{Binding RestoreFormatsCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
