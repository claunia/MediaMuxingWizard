<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MMW.App.ViewModels"
        x:Class="MMW.App.Views.LogWindow"
        x:DataType="vm:LogViewModel"
        Title="Message Log" Width="760" Height="360">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Clear" Command="{Binding ClearCommand}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Entries}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" />
  </DockPanel>
</Window>
