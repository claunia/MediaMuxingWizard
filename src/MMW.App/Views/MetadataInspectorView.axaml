<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMW.App.ViewModels"
             x:Class="MMW.App.Views.MetadataInspectorView"
             x:DataType="vm:MetadataInspectorViewModel">
  <UserControl.Styles>
    <Style Selector="MenuItem" x:DataType="vm:MenuNode">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="ItemsSource" Value="{Binding Children}" />
      <Setter Property="Command" Value="{Binding Command}" />
      <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
    </Style>
  </UserControl.Styles>

  <TabControl SelectedIndex="{Binding SelectedTab}" Padding="8,4">
    <!-- ========================= Tags ========================= -->
    <TabItem Header="Tags">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <DropDownButton ToolTip.Tip="Apply or save a set of tags">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconSets}" Width="14" Height="14" />
              <TextBlock Text="Sets" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout ItemsSource="{Binding SetsMenu}" />
            </DropDownButton.Flyout>
          </DropDownButton>
          <DropDownButton ToolTip.Tip="Add a tag">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
              <TextBlock Text="Add Tag" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout ItemsSource="{Binding AddTagMenu}" />
            </DropDownButton.Flyout>
          </DropDownButton>
          <TextBox Text="{Binding Filter}" PlaceholderText="Filter tags" Width="200" />
        </StackPanel>

        <Panel>
          <TextBlock Text="No tags. Use “Add Tag” or “Sets” to add some, or drop artwork, NFO or chapter files on the window."
                     IsVisible="{Binding IsEmpty}" Classes="dim" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagGroupViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Classes="groupHeader" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.DataTemplates>
                        <!-- Subclasses must come before their base classes. -->
                        <DataTemplate DataType="vm:GenreTagViewModel">
                          <Grid ColumnDefinitions="170,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Classes="label" />
                            <StackPanel Grid.Column="1">
                              <AutoCompleteBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding Suggestions}"
                                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0" />
                              <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove tag" Margin="4,0,0,0">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:TextTagViewModel">
                          <Grid ColumnDefinitions="170,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Classes="label" VerticalAlignment="Top" Margin="0,6,10,0" />
                            <StackPanel Grid.Column="1">
                              <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Watermark}"
                                       AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap"
                                       MaxHeight="160" />
                              <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove tag" Margin="4,0,0,0" VerticalAlignment="Top">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:PeopleTagViewModel">
                          <Grid ColumnDefinitions="170,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Classes="label" VerticalAlignment="Top" Margin="0,6,10,0" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                              <ItemsControl ItemsSource="{Binding People}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="12" Padding="10,3,4,3" Margin="0,2,6,2">
                                      <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Classes="icon" Padding="3" ToolTip.Tip="Remove"
                                                Command="{Binding $parent[ItemsControl;1].((vm:PeopleTagViewModel)DataContext).RemovePersonCommand}"
                                                CommandParameter="{Binding}">
                                          <PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" />
                                        </Button>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBox Text="{Binding NewPerson}" PlaceholderText="Add name…" MinWidth="160" Margin="0,2">
                                <TextBox.KeyBindings>
                                  <KeyBinding Gesture="Enter" Command="{Binding AddPersonCommand}" />
                                </TextBox.KeyBindings>
                              </TextBox>
                            </WrapPanel>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove tag" Margin="4,0,0,0" VerticalAlignment="Top">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:BoolTagViewModel">
                          <Grid ColumnDefinitions="170,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Classes="label" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Value}" />
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove tag" Margin="4,0,0,0">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:EnumTagViewModel">
                          <Grid ColumnDefinitions="170,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Classes="label" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" MinWidth="200" PlaceholderText="Choose…" />
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove tag" Margin="4,0,0,0">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:RatingTagViewModel">
                          <Grid ColumnDefinitions="170,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Classes="label" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" MinWidth="260" PlaceholderText="Choose a rating…" />
                              <TextBlock Text="{Binding Raw}" VerticalAlignment="Center" Classes="dim" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove tag" Margin="4,0,0,0">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </TabItem>

    <!-- ========================= Artwork ========================= -->
    <TabItem Header="Artwork">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
          <Button Classes="icon" Command="{Binding AddArtworkCommand}" ToolTip.Tip="Add artwork from files"><PathIcon Data="{StaticResource IconAdd}" /></Button>
          <Button Classes="icon" Command="{Binding RemoveArtworkCommand}" ToolTip.Tip="Remove the selected artwork"><PathIcon Data="{StaticResource IconDelete}" /></Button>
          <Button Classes="icon" Command="{Binding MoveArtworkUpCommand}" ToolTip.Tip="Move earlier (the first image is the cover)"><PathIcon Data="{StaticResource IconUp}" /></Button>
          <Button Classes="icon" Command="{Binding MoveArtworkDownCommand}" ToolTip.Tip="Move later"><PathIcon Data="{StaticResource IconDown}" /></Button>
          <Button Classes="icon" Command="{Binding ExportArtworkCommand}" ToolTip.Tip="Export the selected artwork"><PathIcon Data="{StaticResource IconExport}" /></Button>
          <TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,4,0" Classes="dim" />
          <Slider Minimum="80" Maximum="400" Value="{Binding ThumbnailSize}" Width="160" VerticalAlignment="Center" />
        </StackPanel>
        <Panel>
          <TextBlock Text="Drop images here or use + to add artwork." Classes="dim"
                     IsVisible="{Binding !Artworks.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ListBox x:Name="ArtworkList" ItemsSource="{Binding Artworks}" SelectedItem="{Binding SelectedArtwork}"
                   Background="Transparent" DragDrop.AllowDrop="True">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ArtworkItemViewModel">
                <StackPanel Spacing="4" Width="{Binding $parent[ListBox].((vm:MetadataInspectorViewModel)DataContext).ThumbnailSize}">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                         Height="{Binding $parent[ListBox].((vm:MetadataInspectorViewModel)DataContext).ThumbnailSize}" />
                  <TextBlock Text="{Binding Description}" FontSize="11" Classes="dim" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
