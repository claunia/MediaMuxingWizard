<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:MMW.App.Resources"
             xmlns:vm="using:MMW.App.ViewModels"
             xmlns:app="using:MMW.App"
             xmlns:views="using:MMW.App.Views"
             x:Class="MMW.App.Views.DocumentView"
             x:DataType="vm:DocumentViewModel">
  <Grid RowDefinitions="Auto,2*,5,3*" Margin="8,6,8,4">
    <Border IsVisible="{Binding HasDolbyVisionNotice}" Margin="0,0,0,6" Padding="10,6"
            CornerRadius="4" BorderThickness="1"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderBrush="{DynamicResource SystemAccentColor}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button Classes="accent" Content="{x:Static res:Strings.Button_RepairDolbyVision}"
                  ToolTip.Tip="{x:Static res:Strings.Tooltip_RepairDolbyVision}"
                  Command="{Binding RepairDolbyVisionCommand}" />
          <Button Content="{x:Static res:Strings.Button_Dismiss}" Command="{Binding DismissDolbyVisionNoticeCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding DolbyVisionNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <DataGrid x:Name="TrackGrid" Grid.Row="1"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              SelectionMode="Extended"
              AutoGenerateColumns="False"
              CanUserReorderColumns="False"
              CanUserSortColumns="False"
              IsReadOnly="False"
              MinHeight="80"
              SelectionChanged="OnSelectionChanged">
      <DataGrid.KeyBindings>
        <KeyBinding Gesture="{x:Static app:Gestures.Delete}" Command="{Binding DeleteTracksCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding DeleteTracksCommand}" />
      </DataGrid.KeyBindings>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static res:Strings.Tracks_Menu_Delete}" Command="{Binding DeleteTracksCommand}" />
          <MenuItem Header="{x:Static res:Strings.Tracks_Menu_MoveUp}" Command="{Binding MoveTrackUpCommand}" />
          <MenuItem Header="{x:Static res:Strings.Tracks_Menu_MoveDown}" Command="{Binding MoveTrackDownCommand}" />
          <Separator />
          <MenuItem Header="{x:Static res:Strings.Tracks_Menu_Duplicate}" Command="{Binding DuplicateTrackCommand}" />
          <MenuItem Header="{x:Static res:Strings.Tracks_Menu_Export}" Command="{Binding ExportTrackCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="36" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TrackRowViewModel">
              <PathIcon Data="{Binding IconKey, Converter={x:Static views:Converters.IconResource}}" Width="16" Height="16" Opacity="0.75" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.Tracks_Column_Id}" Binding="{Binding IdText}" IsReadOnly="True" Width="44" />
        <DataGridTemplateColumn Header="{x:Static res:Strings.Tracks_Column_Enabled}" Width="92">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TrackRowViewModel">
              <CheckBox IsChecked="{Binding Enabled}" IsVisible="{Binding CanToggleEnabled}" HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Static res:Strings.Tracks_Tooltip_Enabled}" ToolTip.Tip="{x:Static res:Strings.Tracks_Tooltip_Enabled}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.Tracks_Column_Name}" Binding="{Binding Name}" Width="3*" />
        <DataGridTextColumn Header="{x:Static res:Strings.Tracks_Column_Duration}" Binding="{Binding Duration}" IsReadOnly="True" Width="104" />
        <DataGridTextColumn Header="{x:Static res:Strings.Tracks_Column_Language}" Binding="{Binding Language}" IsReadOnly="True" Width="130" />
        <DataGridTextColumn Header="{x:Static res:Strings.Tracks_Column_Format}" Binding="{Binding Format}" IsReadOnly="True" Width="3*" />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" />

    <Border Grid.Row="3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" MinHeight="160">
      <ContentControl Content="{Binding Inspector}" />
    </Border>
  </Grid>
</UserControl>
