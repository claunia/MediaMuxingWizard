<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:MMW.App.Resources"
             xmlns:vm="using:MMW.App.ViewModels"
             x:Class="MMW.App.Views.TrackInspectorView"
             x:DataType="vm:TrackInspectorViewModel">
  <TabControl Padding="8,4">
    <TabItem Header="{Binding Header}">
      <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,4">
          <!-- Common -->
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.TrackInspector_Name}" Classes="label" />
            <TextBox Grid.Column="1" Text="{Binding Track.Name, UpdateSourceTrigger=LostFocus}" PlaceholderText="{x:Static res:Strings.TrackInspector_NamePlaceholder}" MinWidth="320" />

            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.TrackInspector_Language}" Classes="label" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                      IsTextSearchEnabled="True" MinWidth="320" MaxDropDownHeight="400" />

            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.TrackInspector_Enabled}" Classes="label" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16">
              <CheckBox IsChecked="{Binding Track.Enabled}" Content="{x:Static res:Strings.TrackInspector_EnabledCheck}" />
              <CheckBox IsChecked="{Binding Track.IsDefault}" Content="{x:Static res:Strings.TrackInspector_Default}" IsVisible="{Binding IsMatroska}" />
              <CheckBox IsChecked="{Binding Track.IsForced}" Content="{x:Static res:Strings.TrackInspector_Forced}" IsVisible="{Binding IsMatroska}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.TrackInspector_AlternateGroup}" Classes="label" IsVisible="{Binding IsMp4}" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:TrackInspectorViewModel.AlternateGroups}"
                      SelectedItem="{Binding SelectedAlternateGroup}" IsVisible="{Binding IsMp4}" MinWidth="120" />

            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.TrackInspector_Delay}" Classes="label" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding StartOffsetMs}" Minimum="-600000" Maximum="600000" Increment="10" FormatString="0" Width="160"
                             AutomationProperties.Name="{x:Static res:Strings.TrackInspector_DelayName}" />
              <TextBlock Text="{x:Static res:Strings.TrackInspector_DelayNote}" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.TrackInspector_Conversion}" Classes="label" IsVisible="{Binding HasConversionChoices}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasConversionChoices}">
              <ComboBox ItemsSource="{Binding ConversionChoices}" SelectedItem="{Binding SelectedConversion}" MinWidth="260"
                        AutomationProperties.Name="{x:Static res:Strings.TrackInspector_ConversionTooltip}" ToolTip.Tip="{x:Static res:Strings.TrackInspector_ConversionTooltip}" />
              <TextBlock Text="{x:Static res:Strings.TrackInspector_AppliedWhenSaving}" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Static vm:TrackInspectorViewModel.OcrWarning}" Classes="error"
                       TextWrapping="Wrap" IsVisible="{Binding IsOcr}" MaxWidth="560" HorizontalAlignment="Left" />

          </Grid>

          <!-- Video -->
          <StackPanel IsVisible="{Binding IsVideo}" Spacing="8">
            <TextBlock Text="{x:Static res:Strings.TrackInspector_Visual}" Classes="groupHeader" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" MaxWidth="720" HorizontalAlignment="Left">
              <TextBlock Text="{x:Static res:Strings.TrackInspector_DisplaySize}" Classes="label" IsVisible="{Binding IsMp4}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMp4}">
                <NumericUpDown Value="{Binding Video.DisplayWidth, FallbackValue=0}" Minimum="0" Maximum="16384" Increment="1" FormatString="0" Width="130" />
                <TextBlock Text="×" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Video.DisplayHeight, FallbackValue=0}" Minimum="0" Maximum="16384" Increment="1" FormatString="0" Width="130" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{x:Static res:Strings.TrackInspector_ColourSpace}" Classes="label" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorPresets}" SelectedItem="{Binding SelectedColorPreset}" MinWidth="260" />
              <TextBlock Grid.Row="2" Text="{x:Static res:Strings.TrackInspector_Hdr}" Classes="label" VerticalAlignment="Top" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HdrText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="{x:Static res:Strings.TrackInspector_Profile}" Classes="label" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Video.ProfileLevel, FallbackValue=''}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- Audio -->
          <StackPanel IsVisible="{Binding IsAudio}" Spacing="8">
            <TextBlock Text="{x:Static res:Strings.TrackInspector_Sound}" Classes="groupHeader" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" MaxWidth="720" HorizontalAlignment="Left">
              <TextBlock Text="{x:Static res:Strings.TrackInspector_Volume}" Classes="label" IsVisible="{Binding IsMp4}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsMp4}">
                <Slider Minimum="-60" Maximum="6" Value="{Binding VolumeDb}" Width="260" />
                <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" MinWidth="60" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{x:Static res:Strings.TrackInspector_Fallback}" Classes="label" IsVisible="{Binding IsMp4}" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FallbackChoices}" SelectedItem="{Binding SelectedFallback}"
                        IsVisible="{Binding IsMp4}" MinWidth="260" AutomationProperties.Name="{x:Static res:Strings.TrackInspector_FallbackTooltip}" ToolTip.Tip="{x:Static res:Strings.TrackInspector_FallbackTooltip}" />
              <TextBlock Grid.Row="2" Text="{x:Static res:Strings.TrackInspector_FollowingSubtitles}" Classes="label" IsVisible="{Binding IsMp4}" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SubtitleChoices}" SelectedItem="{Binding SelectedFollowsSubtitle}"
                        IsVisible="{Binding IsMp4}" MinWidth="260" AutomationProperties.Name="{x:Static res:Strings.TrackInspector_FollowingSubtitlesTooltip}" ToolTip.Tip="{x:Static res:Strings.TrackInspector_FollowingSubtitlesTooltip}" />
            </Grid>
          </StackPanel>

          <!-- Subtitles -->
          <StackPanel IsVisible="{Binding IsSubtitle}" Spacing="8">
            <TextBlock Text="{x:Static res:Strings.TrackInspector_SubtitlesGroup}" Classes="groupHeader" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" MaxWidth="720" HorizontalAlignment="Left" IsVisible="{Binding IsMp4}">
              <TextBlock Text="{x:Static res:Strings.TrackInspector_ForcedMode}" Classes="label" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:TrackInspectorViewModel.ForcedModes}" SelectedItem="{Binding SelectedForcedMode}" MinWidth="260" />
              <TextBlock Grid.Row="1" Text="{x:Static res:Strings.TrackInspector_ForcedTrack}" Classes="label" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SubtitleChoices}" SelectedItem="{Binding SelectedForcedTrack}" MinWidth="260" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{x:Static res:Strings.TrackInspector_MediaCharacteristics}" IsVisible="{Binding HasCharacteristics}">
      <ScrollViewer>
        <StackPanel Margin="0,8">
          <TextBlock Text="{x:Static res:Strings.TrackInspector_CharacteristicsHelp}" Classes="dim" Margin="0,0,0,8" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Characteristics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CharacteristicItemViewModel">
                <CheckBox IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Tag}">
                  <TextBlock Text="{Binding Name}" />
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{x:Static res:Strings.TrackInspector_Info}">
      <ScrollViewer>
        <SelectableTextBlock Text="{Binding InfoText}" Margin="0,8" TextWrapping="Wrap" />
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
