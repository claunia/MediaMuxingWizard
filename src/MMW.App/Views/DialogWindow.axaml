<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MMW.App.Views.DialogWindow"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" MinWidth="360">
  <ContentControl Content="{Binding}" Margin="20" x:DataType="x:Object" />
</Window>
