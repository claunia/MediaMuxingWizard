<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:MMW.App.Resources"
        xmlns:vm="using:MMW.App.ViewModels"
        xmlns:q="using:MMW.Queue"
        xmlns:md="using:MMW.Core.Metadata"
        x:Class="MMW.App.Views.QueueWindow"
        x:DataType="vm:QueueViewModel"
        Title="{x:Static res:Strings.Queue_Title}" Width="1000" Height="640" MinWidth="760" MinHeight="420"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="toolbarBar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="toolbar" Command="{Binding AddCommand}" AutomationProperties.Name="{x:Static res:Strings.Queue_Tooltip_Add}" ToolTip.Tip="{x:Static res:Strings.Queue_Tooltip_Add}">
          <StackPanel><PathIcon Data="{StaticResource IconAdd}" /><TextBlock Classes="caption" Text="{x:Static res:Strings.Queue_Add}" /></StackPanel>
        </Button>
        <Button Classes="toolbar" Command="{Binding RemoveCommand}" AutomationProperties.Name="{x:Static res:Strings.Queue_Tooltip_Remove}" ToolTip.Tip="{x:Static res:Strings.Queue_Tooltip_Remove}">
          <StackPanel><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Classes="caption" Text="{x:Static res:Strings.Queue_Remove}" /></StackPanel>
        </Button>
        <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Button Classes="toolbar" Command="{Binding StartCommand}" AutomationProperties.Name="{x:Static res:Strings.Queue_Tooltip_Start}" ToolTip.Tip="{x:Static res:Strings.Queue_Tooltip_Start}">
          <StackPanel><PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" /><TextBlock Classes="caption" Text="{x:Static res:Strings.Queue_Start}" /></StackPanel>
        </Button>
        <Button Classes="toolbar" Command="{Binding StopCommand}" AutomationProperties.Name="{x:Static res:Strings.Queue_Tooltip_Stop}" ToolTip.Tip="{x:Static res:Strings.Queue_Tooltip_Stop}">
          <StackPanel><PathIcon Data="M18,18H6V6H18V18Z" /><TextBlock Classes="caption" Text="{x:Static res:Strings.Queue_Stop}" /></StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusBar">
      <TextBlock Text="{Binding Summary}" Classes="dim" />
    </Border>

    <Grid ColumnDefinitions="3*,5,2*">
      <!-- Items -->
      <Panel Margin="8">
        <TextBlock Text="{x:Static res:Strings.Queue_Empty}"
                   Classes="dim" IsVisible="{Binding !Items.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" />
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.Queue_Menu_Edit}" Command="{Binding EditCommand}" />
              <MenuItem Header="{x:Static res:Strings.Queue_Menu_Reveal}" Command="{Binding RevealCommand}" />
              <MenuItem Header="{x:Static res:Strings.Queue_Menu_RunAgain}" Command="{Binding RetryCommand}" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.Queue_Menu_RemoveFromQueue}" Command="{Binding RemoveCommand}" />
              <MenuItem Header="{x:Static res:Strings.Queue_Menu_RemoveCompleted}" Command="{Binding RemoveCompletedCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="q:QueueItem">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="2,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="dim" Margin="12,0,0,0" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DestinationPath, StringFormat='→ {0}'}" Classes="dim" FontSize="11"
                           IsVisible="{Binding DestinationPath, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Classes="error"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" MinHeight="4" Margin="0,4,0,0"
                             IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static q:QueueItemStatus.Working}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- Options -->
      <ScrollViewer Grid.Column="2">
        <StackPanel Margin="8,8,12,12" Spacing="6">
          <TextBlock Text="{x:Static res:Strings.Queue_Output}" Classes="groupHeader" />
          <RadioButton Content="{x:Static res:Strings.Queue_SameFolder}" IsChecked="{Binding !UseFolder}" GroupName="loc" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <RadioButton Content="{x:Static res:Strings.Queue_Folder}" IsChecked="{Binding UseFolder}" GroupName="loc" />
            <Button Content="{x:Static res:Strings.Button_Choose}" Command="{Binding ChooseFolderCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Folder}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" IsVisible="{Binding UseFolder}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Static res:Strings.Queue_FileType}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static vm:QueueViewModel.FileTypes}" SelectedItem="{Binding FileType}" MinWidth="200" />
          </StackPanel>
          <CheckBox Content="{x:Static res:Strings.Queue_OptimizeMp4}" IsChecked="{Binding Optimize}" />
          <CheckBox Content="{x:Static res:Strings.Queue_AutoStart}" IsChecked="{Binding AutoStart}" />
          <CheckBox Content="{x:Static res:Strings.Queue_NotifyWhenDone}" IsChecked="{Binding NotifyWhenDone}" />

          <TextBlock Text="{x:Static res:Strings.Queue_Metadata}" Classes="groupHeader" />
          <CheckBox Content="{x:Static res:Strings.Queue_ClearMetadata}" IsChecked="{Binding ClearMetadata}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="{x:Static res:Strings.Queue_FetchMetadata}" IsChecked="{Binding FetchMetadata}" />
            <ComboBox ItemsSource="{x:Static vm:QueueViewModel.ArtworkKinds}" SelectedItem="{Binding FetchArtwork}" MinWidth="120" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="{x:Static res:Strings.Queue_ApplySet}" IsChecked="{Binding ApplyPresetEnabled}" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding ApplyPreset}" MinWidth="160" PlaceholderText="{x:Static res:Strings.Queue_NoSavedSets}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="md:MetadataPreset"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <CheckBox Content="{x:Static res:Strings.Queue_NameFromTags}" IsChecked="{Binding SetOutputFileName}" />
          <CheckBox Content="{x:Static res:Strings.Queue_LoadChapters}" IsChecked="{Binding LoadChapters}" />
          <CheckBox Content="{x:Static res:Strings.Queue_LoadSubtitles}" IsChecked="{Binding LoadSubtitles}" />

          <TextBlock Text="{x:Static res:Strings.Queue_Tracks}" Classes="groupHeader" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="{x:Static res:Strings.Queue_CompleteLanguages}" IsChecked="{Binding CompleteLanguages}" />
            <ComboBox ItemsSource="{x:Static vm:QueueViewModel.Languages}" SelectedItem="{Binding CompleteLanguage}" IsTextSearchEnabled="True" MaxDropDownHeight="360" MinWidth="150" />
          </StackPanel>
          <CheckBox Content="{x:Static res:Strings.Queue_OrganizeGroups}" IsChecked="{Binding OrganizeGroups}" />
          <CheckBox Content="{x:Static res:Strings.Queue_FixFallbacks}" IsChecked="{Binding FixFallbacks}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="{x:Static res:Strings.Queue_EnableAudio}" IsChecked="{Binding EnableAudio}" />
            <ComboBox ItemsSource="{x:Static vm:QueueViewModel.Languages}" SelectedItem="{Binding AudioLanguage}" IsTextSearchEnabled="True" MaxDropDownHeight="360" MinWidth="150" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="{x:Static res:Strings.Queue_EnableSubtitles}" IsChecked="{Binding EnableSubtitles}" />
            <ComboBox ItemsSource="{x:Static vm:QueueViewModel.Languages}" SelectedItem="{Binding SubtitleLanguage}" IsTextSearchEnabled="True" MaxDropDownHeight="360" MinWidth="150" />
          </StackPanel>
          <CheckBox Content="{x:Static res:Strings.Queue_ClearTrackNames}" IsChecked="{Binding ClearTrackNames}" />
          <CheckBox Content="{x:Static res:Strings.Queue_PrettifyAudioNames}" IsChecked="{Binding PrettifyAudioNames}" />
          <CheckBox Content="{x:Static res:Strings.Queue_RenameChapters}" IsChecked="{Binding RenameChapters}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CheckBox Content="{x:Static res:Strings.Queue_ColourSpace}" IsChecked="{Binding ApplyColorSpace}" />
            <ComboBox ItemsSource="{x:Static vm:QueueViewModel.ColorPresets}" SelectedItem="{Binding ColorPreset}" MinWidth="150" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
