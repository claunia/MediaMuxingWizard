<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMW.App.ViewModels"
             x:Class="MMW.App.Views.MessageDialogView"
             x:DataType="vm:MessageDialogViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
    <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="560" />
    <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Button Content="{Binding}" MinWidth="80" HorizontalContentAlignment="Center"
                  Command="{Binding $parent[UserControl].((vm:MessageDialogViewModel)DataContext).ChooseCommand}"
                  CommandParameter="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
