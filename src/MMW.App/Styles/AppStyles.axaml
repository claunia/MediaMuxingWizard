<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Toolbar buttons: icon above a small caption, Subler style. -->
  <Style Selector="Button.toolbar, DropDownButton.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter, DropDownButton.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolbar PathIcon, DropDownButton.toolbar PathIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- Small icon buttons used in inspectors. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.groupHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="Margin" Value="4,12,0,4" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.toolbarBar">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <Style Selector="Border.dropZone">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.dropZone.dragOver">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
  </Style>

  <!-- Compact tab headers for inspectors. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>
</Styles>
