<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MMW.App</RootNamespace>
    <AssemblyName>MediaMuxingWizard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Bound view-model properties must stay instance members even when they do not use instance data. -->
    <!-- CA1863: format strings come from resources and change with the UI language, so caching a CompositeFormat does not apply. -->
    <NoWarn>$(NoWarn);CA1822;CA1863</NoWarn>
    <!-- Strings.resx holds English; other languages are satellite assemblies (Strings.<culture>.resx). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Publishing for a runtime (dotnet publish -r <rid>) gives one self-contained executable with the .NET runtime and
       the managed and native dependencies inside. The FFmpeg and Tesseract libraries stay separate files next to it
       (ffmpeg/, tesseract/): the LGPL requires them to remain replaceable. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship the symbols of their native libraries as package assets, which single-file
       publishing leaves next to the executable. -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>


  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- UI strings: Resources/Strings.resx is the neutral (English) language, Strings.<culture>.resx the translations.
       Strings.Designer.cs is regenerated by Visual Studio/Rider when the resx changes and is committed, because
       `dotnet build` does not run design-time generators. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="Strings.Designer.cs" />
    <Compile Update="Resources\Strings.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="Strings.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MMW.Core\MMW.Core.csproj" />
    <ProjectReference Include="..\MMW.Formats.Mp4\MMW.Formats.Mp4.csproj" />
    <ProjectReference Include="..\MMW.Formats.Matroska\MMW.Formats.Matroska.csproj" />
    <ProjectReference Include="..\MMW.Queue\MMW.Queue.csproj" />
    <ProjectReference Include="..\MMW.Metadata\MMW.Metadata.csproj" />
    <ProjectReference Include="..\MMW.Media.Remux\MMW.Media.Remux.csproj" />
    <ProjectReference Include="..\MMW.Media.Conversion\MMW.Media.Conversion.csproj" />
    <ProjectReference Include="..\MMW.Ocr\MMW.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MMW.App.Tests" />
  </ItemGroup>
</Project>
