<Project>
  <!-- Libraries keep their user-visible text in Resources/Strings.resx (English, the neutral language) and
       Strings.<culture>.resx (translations, built into satellite assemblies). The strongly typed Strings class is
       generated at build time (internal, namespace <RootNamespace>.Resources), so no designer file is committed.
       The App keeps its committed designer (generated by the IDE) and is left alone here. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'MMW.App' and Exists('$(MSBuildProjectDirectory)/Resources/Strings.resx')">
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Format strings come from resources and change with the UI language: caching a CompositeFormat does not apply. -->
    <NoWarn>$(NoWarn);CA1863</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'MMW.App' and Exists('$(MSBuildProjectDirectory)/Resources/Strings.resx')">
    <EmbeddedResource Update="Resources\Strings.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedClassName="Strings"
                      StronglyTypedNamespace="$(RootNamespace).Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" />
  </ItemGroup>
</Project>
