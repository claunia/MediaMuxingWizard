[Desktop Entry]
Type=Application
Name=Media Muxing Wizard
GenericName=Video Muxer and Metadata Editor
Comment=Mux, convert and tag MP4 and Matroska files
Exec=MediaMuxingWizard %F
Icon=com.claunia.MediaMuxingWizard
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=mp4;m4v;mkv;matroska;tags;metadata;chapters;subler;
MimeType=video/mp4;video/x-m4v;audio/mp4;audio/x-m4a;audio/x-m4b;video/quicktime;video/x-matroska;audio/x-matroska;video/webm;
StartupWMClass=MediaMuxingWizard
